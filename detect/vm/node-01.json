{
  "boot-source": {
    "kernel_image_path": "vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw"
  },
  "drives": [
    { "drive_id": "rootfs", "path_on_host": "nodebox-rootfs.ext4", "is_root_device": true, "is_read_only": false }
  ],
  "machine-config": {
    "vcpu_count": 1,
    "mem_size_mib": 128,
    "smt": false
  },
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "host_dev_name": "tap-node01",
      "guest_mac": "AA:FC:00:00:00:01"
    }
  ],
  "mmds-config": {
    "version": "V1",
    "network_interfaces": ["eth0"]
  }
}
