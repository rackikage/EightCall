[Unit]
Description=nodebox node agent (identity + telemetry + typed capabilities)
Documentation=file:/usr/share/doc/nodebox/
After=network-online.target
Wants=network-online.target
# The agent is attributable to THIS unit; attestation_scope = GUEST_USERSPACE.
ConditionPathExists=/etc/nodebox/node.env

[Service]
Type=simple
User=nodebox
Group=nodebox
EnvironmentFile=/etc/nodebox/node.env
ExecStart=/usr/bin/python3 -m nodebox_cli node \
    --state-dir /var/lib/nodebox \
    --device-type ${NODEBOX_DEVICE_TYPE} \
    --controller ${NODEBOX_CONTROLLER} \
    --controller-pub ${NODEBOX_CONTROLLER_PUB} \
    --controller-id ${NODEBOX_CONTROLLER_ID} \
    --telemetry /var/log/nodebox/telemetry.jsonl \
    --interval 30
Restart=on-failure
RestartSec=5

# No privilege escalation, no new privs, locked-down filesystem.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/var/lib/nodebox /var/log/nodebox
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
